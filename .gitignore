internal_files

# Rust
target/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# per-platform plugin binaries: scripts/refresh_plugin_bin.sh locally,
# CI-built at release (the shims directly in bin/ stay tracked)
packages/plugin/bin/*/

# local state
.parsec/
*.onnx
.env
# local platform-stack env (.env.local.example is the tracked template)
.env.local
.DS_Store

# Cloud Run: checkpoint fetched into the brain build context (baked, never committed)
packages/brain/bundle/*
!packages/brain/bundle/.gitkeep

# Cloud Run: bge weights fetched into the brain build context (baked, never committed)
packages/brain/embed-model/*
!packages/brain/embed-model/.gitkeep
