<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- installer -applyChoiceChangesXML fixture for the CI smoke install: the
     choices whose postinstalls only write files (core, codex, opencode, pi) on;
     the ones that need a CLI, Homebrew, or a click (claude, desktop, tray)
     off. A runner has no Claude clients and no one to approve an extension. -->
<plist version="1.0">
<array>
  <dict>
    <key>attributeSetting</key><false/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>claude</string>
  </dict>
  <dict>
    <key>attributeSetting</key><true/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>codex</string>
  </dict>
  <dict>
    <key>attributeSetting</key><true/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>opencode</string>
  </dict>
  <dict>
    <key>attributeSetting</key><true/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>pi</string>
  </dict>
  <dict>
    <key>attributeSetting</key><false/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>desktop</string>
  </dict>
  <dict>
    <key>attributeSetting</key><false/>
    <key>choiceAttribute</key><string>selected</string>
    <key>choiceIdentifier</key><string>tray</string>
  </dict>
</array>
</plist>
