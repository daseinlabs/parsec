{
  "$name": "parsec",
  "$description": "Design tokens for getparsec — retro-terminal, phosphor-on-void. Dark is the default theme.",
  "$version": "1.0.0",
  "color": {
    "brand": {
      "phosphor":     { "value": "#4AF626", "desc": "Primary brand green / accent" },
      "phosphorHover":{ "value": "#64F846", "desc": "Hover for green surfaces" },
      "phosphorPress":{ "value": "#38C41B", "desc": "Active/pressed" },
      "onPhosphor":   { "value": "#06210B", "desc": "Text/icon on a phosphor fill" },
      "mint":         { "value": "#7CFFB2", "desc": "Highlight / bright accent" },
      "dim":          { "value": "#2E7D46", "desc": "Muted green / strong border" },
      "greenLight":   { "value": "#2FA317", "desc": "Brand green for use on LIGHT backgrounds" }
    },
    "bg": {
      "void":     { "value": "#0A0E0C", "desc": "App background" },
      "surface":  { "value": "#0F1512", "desc": "Cards / panels" },
      "elevated": { "value": "#131B17", "desc": "Elevated surface / hover row" },
      "overlay":  { "value": "#16201B", "desc": "Popover / menu" }
    },
    "border": {
      "line":   { "value": "#1D2A22", "desc": "Default hairline border" },
      "strong": { "value": "#2E7D46", "desc": "Emphasised / focus border" }
    },
    "text": {
      "default": { "value": "#D7FBE4", "desc": "Primary foreground" },
      "muted":   { "value": "#8CA897", "desc": "Secondary text" },
      "faint":   { "value": "#556D60", "desc": "Tertiary / disabled" },
      "inverse": { "value": "#0A0E0C", "desc": "Text on light / on phosphor" }
    },
    "status": {
      "success": { "value": "#4AF626" },
      "warning": { "value": "#FFB84D" },
      "error":   { "value": "#FF5C57" },
      "info":    { "value": "#4AD0E0" }
    },
    "accent": {
      "link":    { "value": "#4AD0E0", "desc": "Links / URLs" },
      "magenta": { "value": "#FF5FD2", "desc": "Special / rare highlight" }
    },
    "light": {
      "$note": "Light theme 'Paper' — warm neutral, deep-emerald ink. Sibling of the dark theme.",
      "bg":          { "value": "#F2F5F1", "desc": "App background" },
      "surface":     { "value": "#FFFFFF", "desc": "Cards / panels" },
      "elevated":    { "value": "#FBFDFA", "desc": "Raised surface" },
      "overlay":     { "value": "#FFFFFF", "desc": "Popover / menu" },
      "line":        { "value": "#DCE6DE", "desc": "Hairline border" },
      "lineStrong":  { "value": "#17833A", "desc": "Focus / emphasis border" },
      "text":        { "value": "#0C1410", "desc": "Primary foreground" },
      "muted":       { "value": "#516358", "desc": "Secondary text" },
      "faint":       { "value": "#8A9B8F", "desc": "Tertiary / disabled" },
      "primary":     { "value": "#17833A", "desc": "Interactive accent (passes contrast on white)" },
      "primaryHover":{ "value": "#14712F" },
      "primaryPress":{ "value": "#0F5E27" },
      "onPrimary":   { "value": "#FFFFFF", "desc": "Text/icon on a primary fill" },
      "logoGreen":   { "value": "#2FA317", "desc": "Bright brand green for the logo/graphics on light" },
      "mintSoft":    { "value": "#E4F7EC", "desc": "Soft success/highlight surface tint" },
      "success":     { "value": "#17833A" },
      "warning":     { "value": "#B7791F" },
      "error":       { "value": "#C6362F" },
      "info":        { "value": "#0E7490" },
      "link":        { "value": "#0E7490" },
      "magenta":     { "value": "#B0359C" }
    }
  },
  "font": {
    "mono":     { "value": "'JetBrains Mono', ui-monospace, 'IBM Plex Mono', SFMono-Regular, Menlo, monospace" },
    "monoAlt":  { "value": "'IBM Plex Mono', ui-monospace, monospace" },
    "sans":     { "value": "'IBM Plex Sans', -apple-system, Segoe UI, Roboto, sans-serif" },
    "weight": { "regular": 400, "medium": 500, "bold": 700, "extrabold": 800 }
  },
  "fontSize": {
    "xs":   { "value": "0.75rem",  "px": 12 },
    "sm":   { "value": "0.8125rem","px": 13 },
    "base": { "value": "0.9375rem","px": 15 },
    "md":   { "value": "1rem",     "px": 16 },
    "lg":   { "value": "1.25rem",  "px": 20 },
    "xl":   { "value": "1.75rem",  "px": 28 },
    "2xl":  { "value": "2.5rem",   "px": 40 },
    "3xl":  { "value": "3.5rem",   "px": 56 }
  },
  "lineHeight": { "tight": 1.15, "snug": 1.35, "normal": 1.6 },
  "letterSpacing": { "display": "-0.01em", "body": "0.01em", "caps": "0.12em" },
  "space": {
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px"
  },
  "radius": {
    "sm": "4px", "md": "8px", "lg": "12px", "xl": "20px", "pill": "999px"
  },
  "border": { "hairline": "1px", "thick": "2px" },
  "shadow": {
    "sm":   { "value": "0 1px 2px rgba(0,0,0,.4)" },
    "md":   { "value": "0 8px 24px rgba(0,0,0,.45)" },
    "lg":   { "value": "0 24px 60px rgba(0,0,0,.55)" },
    "glow": { "value": "0 0 6px rgba(74,246,38,.55), 0 0 22px rgba(74,246,38,.20)", "desc": "Phosphor glow for accents" },
    "glowStrong": { "value": "0 0 8px rgba(74,246,38,.9), 0 0 26px rgba(74,246,38,.35)" }
  },
  "motion": {
    "fast": "120ms", "base": "180ms", "slow": "280ms",
    "ease": "cubic-bezier(.2,.6,.2,1)"
  }
}
