# Local platform stack (docker-compose.yml, `platform` profile).
#   cp .env.local.example .env.local
#
# This is the CONTROL-PLANE env only. The frontend has its own
# packages/frontend/.env.local (Supabase URL + publishable key, PLATFORM_URL).

# How the platform verifies the Supabase JWT the frontend sends. Point this at
# the same project the frontend signs in against — the schema stores the JWT's
# `sub` as an opaque TEXT account_id, so a local database and hosted Supabase
# Auth compose fine (no FK to auth.users). Swap in a dev project's ref here to
# test against a different one.
SUPABASE_JWKS_URL=https://kgbzlkqigwjyzmvpbyez.supabase.co/auth/v1/.well-known/jwks.json
# Symmetric alternative (legacy projects): set this INSTEAD of the JWKS URL.
# SUPABASE_JWT_SECRET=

# Local Postgres from `docker compose up -d db`, as seen FROM THE HOST — for
# running the API outside the container:
#   cd packages/platform && uv run --extra postgres \
#     uvicorn --factory parsec_platform:create_app --port 8080
# The `platform` service overrides this to db:5432 for the container network.
PARSEC_PLATFORM_DB_URL=postgresql://parsec:dev@127.0.0.1:5432/parsec

# Grant entitlement on sight instead of waiting for a Stripe webhook, so key
# minting works locally without billing.
PARSEC_AUTO_ENTITLE=1

# Only needed if you're replaying Stripe webhooks at the local service.
# STRIPE_WEBHOOK_SECRET=
